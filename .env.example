# ── Backend (read by backend/app/config.py; copy to backend/.env or project-root .env) ──

# Optional. Enables Claude-powered answers in "Ask WeatherLens".
# Without it, a deterministic rule engine answers from the same weather data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional overrides (defaults shown)
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# OSRM_URL=https://router.project-osrm.org
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# HTTP_USER_AGENT=WeatherLens/1.0 (you@example.com)
# FORECAST_TTL=600

# ── Frontend (Vite; copy to frontend/.env.local) ──
# Leave empty in dev: Vite proxies /api → http://localhost:8000
VITE_API_BASE_URL=

# Optional basemap overrides (default: keyless Esri Canvas tiles)
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_URL_DARK=
